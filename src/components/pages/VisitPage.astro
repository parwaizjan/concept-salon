---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getEntry, render } from "astro:content";
import OpeningHours from "../visit/OpeningHours.astro";
import MapEmbed from "../visit/MapEmbed.astro";
import ContactLinks from "../visit/ContactLinks.astro";
import { type Locale } from "../../data/site";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const entry =
  (await getEntry("pages", `visit/${lang}`)) ??
  (await getEntry("pages", "visit/en"));

const rendered = entry ? await render(entry) : null;
const Content = rendered?.Content;
---

<BaseLayout lang={lang} path="/visit" title={entry?.data.title}>
  <section class="container-page py-12">
    <h1 class="font-heading text-4xl">{entry?.data.title}</h1>
    <div class="mt-3 max-w-2xl leading-relaxed text-text-muted">
      {Content && <Content />}
    </div>

    <div class="mt-8 grid gap-8 md:grid-cols-3">
      <ContactLinks lang={lang} />
      <OpeningHours lang={lang} />
      <MapEmbed lang={lang} />
    </div>
  </section>
</BaseLayout>
