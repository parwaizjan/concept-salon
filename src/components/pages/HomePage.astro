---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../hero/Hero.astro";
import FeaturedServices from "../services/FeaturedServices.astro";
import Testimonials from "../Testimonials.astro";
import GalleryGrid from "../gallery/GalleryGrid.astro";
import MediaImage from "../MediaImage.astro";
import ContactLinks from "../visit/ContactLinks.astro";
import OpeningHours from "../visit/OpeningHours.astro";
import MapEmbed from "../visit/MapEmbed.astro";
import { site, type Locale } from "../../data/site";
import { aboutImage } from "../../data/about-image";
import { getServices } from "../../lib/services";
import { useTranslations, localizePath } from "../../i18n/utils";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const services = await getServices(lang);

const steps = [
  { title: "how.step1Title", body: "how.step1Body" },
  { title: "how.step2Title", body: "how.step2Body" },
  { title: "how.step3Title", body: "how.step3Body" },
] as const;
---

<BaseLayout lang={lang} path="/">
  <Fragment slot="head">
    <link
      rel="preload"
      as="image"
      href={site.heroImage}
      imagesrcset={site.heroImageSrcSet}
      imagesizes="100vw"
      media="(min-width: 640px)"
    />
    <link
      rel="preload"
      as="image"
      href={site.heroImageMobile}
      media="(max-width: 639px)"
    />
  </Fragment>

  <Hero lang={lang} />

  <section class="border-y border-border bg-surface py-4">
    <div
      class="container-page flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-sm"
    >
      <span class="text-text-muted"
        >{site.address[lang] ?? site.address.en}</span
      >
      {
        site.phone && (
          <a class="underline" href={`tel:${site.phone.replace(/\s+/g, "")}`}>
            {site.phone}
          </a>
        )
      }
      <a
        href={localizePath("/book", lang)}
        class="font-medium text-primary underline"
      >
        {t("common.bookNow")}
      </a>
    </div>
  </section>

  <FeaturedServices services={services} lang={lang} />

  <section class="container-page py-12">
    <h2 class="font-heading text-3xl">{t("how.title")}</h2>
    <ol class="mt-6 grid gap-4 sm:grid-cols-3">
      {
        steps.map((step, index) => (
          <li class="card p-4">
            <span class="badge bg-surface-alt text-text">{index + 1}</span>
            <h3 class="mt-2 font-heading text-lg">{t(step.title)}</h3>
            <p class="mt-1 text-sm text-text-muted">{t(step.body)}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="container-page grid items-center gap-8 py-12 md:grid-cols-2">
    <div>
      <h2 class="font-heading text-3xl">{t("about.title")}</h2>
      <p class="mt-3 text-text-muted">{t("about.teaser")}</p>
      <a href={localizePath("/about", lang)} class="btn btn-outline mt-5">
        {t("about.readMore")}
      </a>
    </div>
    <MediaImage
      image={aboutImage}
      alt={t("about.imageAlt")}
      widths={[480, 800, 1200]}
      sizes="(min-width: 768px) 50vw, 100vw"
      class="aspect-[4/3] w-full rounded-lg border border-border object-cover"
    />
  </section>

  <section class="bg-surface-alt py-12">
    <div class="container-page">
      <div class="mb-4 flex items-end justify-between gap-4">
        <h2 class="font-heading text-2xl">{t("gallery.title")}</h2>
        <a
          href={localizePath("/gallery", lang)}
          class="text-sm font-medium text-primary underline"
        >
          {t("common.viewGallery")}
        </a>
      </div>
      <GalleryGrid lang={lang} />
    </div>
  </section>

  <Testimonials lang={lang} />

  <section class="container-page py-12">
    <h2 class="mb-6 font-heading text-3xl">{t("visit.title")}</h2>
    <div class="grid gap-8 md:grid-cols-3">
      <ContactLinks lang={lang} />
      <OpeningHours lang={lang} />
      <MapEmbed lang={lang} />
    </div>
  </section>
</BaseLayout>
