{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "concept-salon",
  "workers_dev": false,
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@astrojs/cloudflare/entrypoints/server",
  "assets": {
    "not_found_handling": "404-page",
  },
  "observability": {
    "enabled": true,
  },
}
